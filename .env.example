# Приложение
APP_NAME=Skaitītāji
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///./data/skaititaji.db
DEFAULT_LOCALE=lv
DEBUG=1

# SEC-003: ключ симметричного шифрования секретов интеграций at-rest.
# Обязателен в проде (boot-guard упадёт без него). В dev при отсутствии
# генерируется эфемерный ключ на процесс (секреты не переживают рестарт).
# Сгенерировать: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SECRETS_ENCRYPTION_KEY=

# Интеграция Visma Horizon REST API
# VISMA_MOCK=1 — демо без реального сервера (по умолчанию).
# Для реального подключения установите VISMA_MOCK=0 и заполните остальное.
VISMA_MOCK=1
VISMA_BASE_URL=
VISMA_USERNAME=
VISMA_PASSWORD=
